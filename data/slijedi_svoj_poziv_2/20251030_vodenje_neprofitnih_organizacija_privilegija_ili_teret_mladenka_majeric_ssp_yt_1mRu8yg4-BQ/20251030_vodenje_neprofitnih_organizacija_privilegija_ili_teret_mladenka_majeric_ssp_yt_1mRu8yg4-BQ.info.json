DIO OSTVARENJA NAŠE MISIJE?\n\n\nSvojom donacijom omogućuješ i drugima kvalitetniji odnos s Bogom, svijetom i sa samima sobom.\n\n\nSvoju podršku možeš pružiti preko jednokratne, mjesečne ili godišnje donacije - https://www.ignacije.hr/podrska/ \n\n\nHvala ti što svojim darom činiš da naši programi budu prostor duhovnog rasta. Donacija nije samo materijalna pomoć, već znak solidarnosti i zajedničkog ostvarivanja Kraljevstva Božjeg. \n\n\nhttps://www.instagram.com/ignacije.hr/\nhttps://www.facebook.com/ignacije.hr", "channel_id": "UCuk9D5H9mx7birJ1-S22nyQ", "channel_url": "https://www.youtube.com/channel/UCuk9D5H9mx7birJ1-S22nyQ", "duration": 1327, "view_count": 127, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=1mRu8yg4-BQ", "categories": ["Nonprofits & Activism"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 1, "like_count": 6, "channel": "Centar Ignacije", "channel_follower_count": 474, "uploader": "Centar Ignacije", "uploader_id": "@ignacijehr", "uploader_url": "https://www.youtube.com/@ignacijehr", "upload_date": "20251030", "timestamp": 1761824839, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "1mRu8yg4-BQ", "fulltitle": "Vođenje neprofitnih organizacija - privilegija ili teret? | Mladenka Majerić | SSP", "duration_string": "22:07", "is_live": false, "was_live": false, "epoch": 1784211859, "format": "134 - 640x360 (360p)+251 - audio only (medium)", "format_id": "134+251", "ext": "mkv", "protocol": "https+https", "format_note": "360p+medium", "filesize_approx": 50755247, "tbr": 305.88800000000003, "width": 640, "height": 360, "resolution": "640x360", "fps": 30, "dynamic_range": "SDR", "vcodec": "avc1.4d401e", "v