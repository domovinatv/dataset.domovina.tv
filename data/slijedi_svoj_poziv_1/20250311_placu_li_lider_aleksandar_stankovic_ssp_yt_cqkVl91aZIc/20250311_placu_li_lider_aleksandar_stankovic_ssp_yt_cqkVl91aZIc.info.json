ja je 12. svibnja 2024. doživjela svoje tisućito izdanje.\n\nIzdao je pet knjiga – tri knjige poezije, jednu knjigu o emisiji “Nedjeljom u 2” te knjigu “Depra”. Za HRT je napravio dva dokumentarna filma i moto putopis “Vjetar u kosi” koji je doživio pet sezona.", "channel_id": "UCuk9D5H9mx7birJ1-S22nyQ", "channel_url": "https://www.youtube.com/channel/UCuk9D5H9mx7birJ1-S22nyQ", "duration": 1241, "view_count": 68, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=cqkVl91aZIc", "categories": ["Nonprofits & Activism"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "like_count": 1, "channel": "Centar Ignacije", "channel_follower_count": 474, "uploader": "Centar Ignacije", "uploader_id": "@ignacijehr", "uploader_url": "https://www.youtube.com/@ignacijehr", "upload_date": "20250311", "timestamp": 1741689357, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "cqkVl91aZIc", "fulltitle": "Plaču li lider? | Aleksandar Stanković | SSP", "duration_string": "20:41", "is_live": false, "was_live": false, "epoch": 1784211639, "format": "134 - 640x360 (360p)+251 - audio only (medium)", "format_id": "134+251", "ext": "mkv", "protocol": "https+https", "format_note": "360p+medium", "filesize_approx": 57678081, "tbr": 371.752, "width": 640, "height": 360, "resolution": "640x360", "fps": 30, "dynamic_range": "SDR", "vcodec": "avc1.4d401e", "vbr": 252.958, "aspect_ratio": 1.78, "acodec": "opus", "abr": 118.794, "asr": 48000, "audio_channels": 2, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}