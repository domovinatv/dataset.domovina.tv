 "https://i.ytimg.com/vi/7eOOXWVrWcY/maxresdefault.jpg", "description": "Na prvom Mladifestu u Hrvatskoj, u petak 21. lipnja 2019. \nodržana je pretpremijera knjige “Međugorje – Prvih sedam dana”, autora Darka Pavičića, novinara Večernjeg lista.\n\nNovinar Pavičić je, nakon objave u svibnju 2017. neslužbenog nalaza \nMeđunarodne komisije za Međugorje, koju je osnovao papa Benedikt XVI., da je prvih sedam dana ukazanja autentično, napravio rekonstrukciju zbivanja tih  prvih dana, koji bi mogli biti ugrađeni jednoga dana u temelj službenog priznanja međugorskog fenomena.\n\nKnjiga “Međugorje – prvih sedam dana” rekonstrukcija je cjelokupnih zbivanja od 24. lipnja do 2. srpnja i nastala je kroz razgovore s vidiocima i \nsvjedocima, istraživanjem dokumenata vremena i na audiozapisima razgovora fra Joze Zovka s vidiocima te prvi put, na jednome mjestu, donosi svu ustreptalost toga trenutka, sve sumnje i strahove, vjeru, odlučnost i \ndramatičnost toga nebeskog zahvata koji je snažno obilježio vrijeme u kojemu živimo.", "channel_id": "UCc4tNmsij59QsM36bal0ZPg", "channel_url": "https://www.youtube.com/channel/UCc4tNmsij59QsM36bal0ZPg", "duration": 1787, "view_count": 170, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=7eOOXWVrWcY", "categories": ["Nonprofits & Activism"], "tags": ["Mladifest", "Hrvatska", "Viduševac", "Međugorje", "2019.", "Knjiga", "Međugorje – prvih sedam dana", "Ukazanja", "Vidioci"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "like_count": 5, "channel": "Mladifest Hrvatska", "channel_follower_count": 6280, "uploader": "Mladifest Hrvatska", "uploader_id": "@MladifestHrvatska", "uploader_url": "https://www.youtube.com/@MladifestHrvatska", "upload_date": "20201028", "timestamp": 1603883073, "availability": "public", "webpage_url_basename": "watch