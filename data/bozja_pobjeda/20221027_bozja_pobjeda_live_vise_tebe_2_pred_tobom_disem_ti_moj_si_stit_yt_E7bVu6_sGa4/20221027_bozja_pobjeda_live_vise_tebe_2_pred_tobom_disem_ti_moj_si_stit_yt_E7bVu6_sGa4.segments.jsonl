{"id":"E7bVu6_sGa4_36","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":36,"start_sec":825.2,"end_sec":840.72,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Govoriš mi, Gerjana, za tobom žu."}
