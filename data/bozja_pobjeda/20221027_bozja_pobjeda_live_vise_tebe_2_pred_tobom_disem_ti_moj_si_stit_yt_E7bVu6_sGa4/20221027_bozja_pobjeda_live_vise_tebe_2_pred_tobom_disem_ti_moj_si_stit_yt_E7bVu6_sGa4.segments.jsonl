{"id":"E7bVu6_sGa4_46","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":46,"start_sec":1049.44,"end_sec":1050.64,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Gospodine, ti si rekao da bez."}
{"id":"E7bVu6_sGa4_47","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":47,"start_sec":1051.12,"end_sec":1055.36,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"tebe ne možemo ništa, da bez tebe ne možemo ništa."}
{"id":"E7bVu6_sGa4_48","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":48,"start_sec":1059.68,"end_sec":1061.12,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Mi to svačamo, gospodine."}
{"id":"E7bVu6_sGa4_49","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":49,"start_sec":1063.6,"end_sec":1073.36,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Možda nismo uvijek kompletno svjesni toga, ali sada priznajemo da ne možemo bez tebe."}
