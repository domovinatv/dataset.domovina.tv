{"id":"E7bVu6_sGa4_32","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":32,"start_sec":614.56,"end_sec":619.68,"speaker_id":"SPEAKER_00","speaker":"Ana Buljan","srt_source":"sortformer","text":"Pronađe nas, pronađe nas, Gospodine, u našim potrebama."}
{"id":"E7bVu6_sGa4_33","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":33,"start_sec":621.52,"end_sec":629.36,"speaker_id":"SPEAKER_00","speaker":"Ana Buljan","srt_source":"sortformer","text":"Ti si naš početak i naš kraj, ti si nas, naš pastir, ti nas vodi, Isuse."}
