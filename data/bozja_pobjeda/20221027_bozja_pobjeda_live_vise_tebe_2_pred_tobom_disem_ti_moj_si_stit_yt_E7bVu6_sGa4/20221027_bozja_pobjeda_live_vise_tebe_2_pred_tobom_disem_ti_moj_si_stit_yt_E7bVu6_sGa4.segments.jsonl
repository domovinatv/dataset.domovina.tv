{"id":"E7bVu6_sGa4_39","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":39,"start_sec":952.24,"end_sec":954.48,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Cijelo naše biće ovisno o tebi."}
{"id":"E7bVu6_sGa4_40","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":40,"start_sec":959.04,"end_sec":967.28,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Kada svijet uzdiže nezavisnonost i neovisnost, samostalnost, mi ti želimo reći da smo ovisni o tebi."}
