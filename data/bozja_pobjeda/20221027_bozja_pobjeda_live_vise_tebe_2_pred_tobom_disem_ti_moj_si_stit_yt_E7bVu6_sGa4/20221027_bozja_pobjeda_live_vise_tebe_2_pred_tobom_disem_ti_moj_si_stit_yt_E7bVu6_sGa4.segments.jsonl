{"id":"E7bVu6_sGa4_26","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":26,"start_sec":422.96,"end_sec":434.56,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Da smo ovisni o tebi, da smo te želji, da želimo biti u tvojoj prisutnosti jer znamo da ona mijenja."}
