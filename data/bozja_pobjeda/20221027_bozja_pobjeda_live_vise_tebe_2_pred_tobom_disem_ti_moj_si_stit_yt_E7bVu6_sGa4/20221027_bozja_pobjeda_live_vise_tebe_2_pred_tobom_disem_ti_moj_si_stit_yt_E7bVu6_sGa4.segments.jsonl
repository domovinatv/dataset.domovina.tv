{"id":"E7bVu6_sGa4_29","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":29,"start_sec":465.68,"end_sec":476.96,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Živjeti ja želim u tvojem svjetlu."}
{"id":"E7bVu6_sGa4_30","youtube_id":"E7bVu6_sGa4","channel":"bozja_pobjeda","upload_date":"2022-10-27","seq":30,"start_sec":481.44,"end_sec":509.28,"speaker_id":"SPEAKER_01","speaker":"Gost 1","srt_source":"sortformer","text":"Slijedi tvoja staza, tebi život predati, živi ti ja želi, u tvojem svjetlu."}
